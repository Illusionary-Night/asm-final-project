.NOLIST
IFNDEF __Character
__Character EQU 1
INGAMEATTRIBUTE STRUCT
	HP SDWORD ?			; Health Points 生命值
	EP SDWORD ?			; Stamina Points 耐力值
	MP SDWORD ?			; Magic Points 魔力值
INGAMEATTRIBUTE ENDS

RESOURCEATTRIBUTE STRUCT
	MAXHP SDWORD ?		; 生命值上限
	MAXEP SDWORD ?		; 耐力值上限
	MAXMP SDWORD ?		; 魔力值上限
	MONEY SDWORD ?		;金錢數量 用來購買道具
	LIVES SDWORD ?		;生命數量 可被擊敗次數
RESOURCEATTRIBUTE ENDS

CHARACTERATTRIBUTE STRUCT
	InGame INGAMEATTRIBUTE <>
	Resource RESOURCEATTRIBUTE <>
CHARACTERATTRIBUTE ENDS

;INGAME 

SetInGameAttribute PROTO :PTR INGAMEATTRIBUTE, :SDWORD, :SDWORD, :SDWORD

InitializeInGameAttribute PROTO :PTR CHARACTERATTRIBUTE	;初始化遊戲中屬性

CheckInGameStatEnough PROTO :PTR INGAMEATTRIBUTE, :PTR SDWORD, :SDWORD	;判斷是否有足夠的HP, EP, MP 

OverlayInGameAttribute PROTO :PTR CHARACTERATTRIBUTE, :PTR INGAMEATTRIBUTE, :DWORD; 疊加遊戲中屬性 參數3 = TypeFlag: 0 = Demand, 1 = Effect 需求不滿無效並回傳1在eax


;RESOURCE

SetResourceAttribute PROTO :PTR RESOURCEATTRIBUTE, :SDWORD, :SDWORD, :SDWORD, :SDWORD, :SDWORD

InitializeResourceAttribute PROTO :PTR RESOURCEATTRIBUTE	;初始化資源屬性

;CHARACTER

CheckMoneyEnough PROTO :PTR CHARACTERATTRIBUTE, :SDWORD	;判斷是否有足夠的Money ;回傳到eax, 1:構, 0:否

CheckCharacterAlive PROTO :PTR CHARACTERATTRIBUTE	;回傳到eax, 1:活著, 0:死掉

ENDIF